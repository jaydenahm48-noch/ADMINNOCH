<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NochyOS Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0f0; min-height: 100vh; }

    .layout { display: flex; min-height: 100vh; }

    .sidebar {
      width: 220px; background: #1a1a2e; border-right: 1px solid #2a2a4a;
      padding: 24px 0; flex-shrink: 0; position: fixed; top: 0; left: 0; bottom: 0;
    }
    .sidebar-logo { padding: 0 20px 24px; font-size: 16px; font-weight: 700; color: #7c6fff; border-bottom: 1px solid #2a2a4a; margin-bottom: 16px; }
    .sidebar-logo span { color: #e0e0f0; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer; color: #888; font-size: 14px; transition: all 0.15s; border-left: 3px solid transparent; }
    .nav-item:hover { background: #252540; color: #e0e0f0; }
    .nav-item.active { background: #252540; color: #7c6fff; border-left-color: #7c6fff; }

    .main { margin-left: 220px; flex: 1; padding: 32px; }
    .page { display: none; }
    .page.active { display: block; }

    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
    .page-title { font-size: 22px; font-weight: 700; }
    .page-subtitle { font-size: 13px; color: #888; margin-top: 4px; }

    .btn { padding: 9px 18px; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s; }
    .btn-primary { background: #7c6fff; color: #fff; }
    .btn-primary:hover { background: #6a5fee; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-danger { background: #ff4f4f22; color: #ff6b6b; border: 1px solid #ff4f4f44; }
    .btn-danger:hover { background: #ff4f4f44; }
    .btn-secondary { background: #252540; color: #aaa; border: 1px solid #3a3a5a; }
    .btn-secondary:hover { background: #2e2e50; color: #e0e0f0; }
    .btn-sm { padding: 5px 12px; font-size: 12px; }

    /* LOGIN */
    .login-screen {
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh; background: #0f0f1a;
    }
    .login-box {
      background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 14px;
      padding: 40px; width: 360px; text-align: center;
    }
    .login-logo { font-size: 24px; font-weight: 700; color: #7c6fff; margin-bottom: 8px; }
    .login-logo span { color: #e0e0f0; }
    .login-subtitle { color: #888; font-size: 13px; margin-bottom: 28px; }

    /* GRID */
    .project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
    .project-card { background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; overflow: hidden; transition: border-color 0.15s; }
    .project-card:hover { border-color: #7c6fff; }
    .project-thumb { width: 100%; height: 160px; object-fit: cover; background: #252540; display: block; }
    .project-thumb-placeholder { width: 100%; height: 160px; background: linear-gradient(135deg, #252540, #1a1a2e); display: flex; align-items: center; justify-content: center; font-size: 32px; color: #3a3a5a; }
    .project-body { padding: 14px; }
    .project-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
    .project-category { font-size: 11px; color: #7c6fff; background: #7c6fff22; padding: 2px 8px; border-radius: 20px; display: inline-block; margin-bottom: 8px; }
    .project-desc { font-size: 12px; color: #888; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 10px; }
    .tech-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 12px; }
    .tech-tag { font-size: 10px; padding: 2px 7px; background: #252540; border: 1px solid #3a3a5a; border-radius: 4px; color: #aaa; }
    .project-actions { display: flex; gap: 8px; }

    /* MODAL */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 100; align-items: center; justify-content: center; padding: 20px; }
    .modal-overlay.open { display: flex; }
    .modal { background: #1a1a2e; border: 1px solid #3a3a5a; border-radius: 14px; width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; }
    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid #2a2a4a; }
    .modal-title { font-size: 16px; font-weight: 700; }
    .modal-close { background: none; border: none; color: #888; cursor: pointer; font-size: 20px; }
    .modal-close:hover { color: #e0e0f0; }
    .modal-body { padding: 24px; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 24px; border-top: 1px solid #2a2a4a; }

    /* FORM */
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 12px; font-weight: 600; color: #aaa; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-input, .form-textarea { width: 100%; background: #0f0f1a; border: 1px solid #3a3a5a; border-radius: 8px; padding: 10px 14px; color: #e0e0f0; font-size: 14px; transition: border-color 0.15s; font-family: inherit; }
    .form-input:focus, .form-textarea:focus { outline: none; border-color: #7c6fff; }
    .form-textarea { resize: vertical; min-height: 80px; }
    .form-hint { font-size: 11px; color: #666; margin-top: 4px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    /* UPLOAD AREA */
    .upload-area {
      border: 2px dashed #3a3a5a; border-radius: 8px; padding: 20px;
      text-align: center; cursor: pointer; transition: border-color 0.15s; position: relative;
    }
    .upload-area:hover { border-color: #7c6fff; }
    .upload-area input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .upload-area .upload-icon { font-size: 24px; margin-bottom: 6px; }
    .upload-area p { font-size: 12px; color: #888; }
    .upload-preview { width: 100%; max-height: 150px; object-fit: cover; border-radius: 6px; margin-top: 10px; display: none; }

    /* TOAST */
    .toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 999; display: flex; flex-direction: column; gap: 8px; }
    .toast { padding: 12px 18px; border-radius: 8px; font-size: 13px; font-weight: 500; animation: slideIn 0.2s ease; max-width: 320px; }
    .toast.success { background: #1a3a2a; color: #4ade80; border: 1px solid #2a5a3a; }
    .toast.error { background: #3a1a1a; color: #f87171; border: 1px solid #5a2a2a; }
    @keyframes slideIn { from { opacity: 0; transform: translateY(10px); } }

    .loading { display: flex; align-items: center; justify-content: center; padding: 60px; color: #888; gap: 12px; }
    .spinner { width: 20px; height: 20px; border: 2px solid #3a3a5a; border-top-color: #7c6fff; border-radius: 50%; animation: spin 0.6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .empty-state { text-align: center; padding: 60px 20px; color: #666; }
    .empty-state .empty-icon { font-size: 48px; margin-bottom: 12px; }
    .empty-state p { margin-bottom: 16px; }
  </style>
</head>
<body>

<!-- LOGIN SCREEN -->
<div class="login-screen" id="loginScreen">
  <div class="login-box">
    <div class="login-logo">Nochy<span>OS</span></div>
    <div class="login-subtitle">Admin Panel</div>
    <div class="form-group">
      <input type="password" class="form-input" id="loginPassword" placeholder="Password admin..." onkeydown="if(event.key==='Enter')login()">
    </div>
    <button class="btn btn-primary" style="width:100%" onclick="login()">Masuk</button>
    <p id="loginError" style="color:#f87171;font-size:12px;margin-top:12px;display:none">Password salah</p>
  </div>
</div>

<!-- ADMIN LAYOUT -->
<div class="layout" id="adminLayout" style="display:none">
  <aside class="sidebar">
    <div class="sidebar-logo">Nochy<span>OS</span> Admin</div>
    <nav>
      <div class="nav-item active" onclick="showPage('projects', this)">📁 Projects</div>
      <div class="nav-item" onclick="showPage('settings', this)">⚙️ Settings</div>
      <div class="nav-item" onclick="logout()" style="margin-top:auto;position:absolute;bottom:20px;left:0;right:0">🚪 Logout</div>
    </nav>
  </aside>

  <main class="main">
    <!-- PROJECTS PAGE -->
    <div class="page active" id="page-projects">
      <div class="page-header">
        <div>
          <div class="page-title">Projects</div>
          <div class="page-subtitle">Manage semua project portofolio</div>
        </div>
        <button class="btn btn-primary" onclick="openAddModal()">+ Tambah Project</button>
      </div>
      <div id="projectList">
        <div class="loading"><div class="spinner"></div> Memuat...</div>
      </div>
    </div>

    <!-- SETTINGS PAGE -->
    <div class="page" id="page-settings">
      <div class="page-header">
        <div class="page-title">Settings</div>
      </div>
      <div style="background:#1a1a2e;border:1px solid #2a2a4a;border-radius:12px;padding:24px;max-width:500px;">
        <div class="form-group">
          <label class="form-label">API Base URL</label>
          <input type="text" class="form-input" id="settingsApiUrl" placeholder="https://your-domain.vercel.app">
          <p class="form-hint">URL deployment Vercel kamu. Kalau local dev: http://localhost:3000</p>
        </div>
        <button class="btn btn-primary" onclick="saveSettings()">Simpan</button>
      </div>
    </div>
  </main>
</div>

<!-- MODAL PROJECT -->
<div class="modal-overlay" id="projectModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Tambah Project</span>
      <button class="modal-close" onclick="closeModal()">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editId">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Judul *</label>
          <input type="text" class="form-input" id="f_judul" placeholder="Nochy Eat">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Deskripsi *</label>
        <textarea class="form-textarea" id="f_deskripsi" placeholder="Deskripsi project..."></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Thumbnail</label>
        <div class="upload-area" id="thumbUploadArea">
          <input type="file" accept="image/*" onchange="handleUpload(this, 'thumbnail')">
          <div class="upload-icon">🖼️</div>
          <p>Klik atau drag gambar cover</p>
        </div>
        <img id="thumbPreview" class="upload-preview">
        <input type="hidden" id="f_url_thumbnail">
        <p class="form-hint">Atau isi URL langsung:</p>
        <input type="text" class="form-input" id="f_url_thumbnail_manual"
          placeholder="https://drive.google.com/uc?id=..."
          oninput="document.getElementById('f_url_thumbnail').value=this.value"
          style="margin-top:6px">
      </div>

      <div class="form-group">
        <label class="form-label">Gambar Detail</label>
        <div class="upload-area">
          <input type="file" accept="image/*" multiple onchange="handleMultiUpload(this)">
          <div class="upload-icon">📸</div>
          <p>Upload multiple gambar (opsional)</p>
        </div>
        <input type="text" class="form-input" id="f_gambar_detail"
          placeholder="URL dipisah koma, atau upload di atas"
          style="margin-top:8px">
        <p class="form-hint">Multiple URL dipisah koma</p>
      </div>

      <div class="form-group">
        <label class="form-label">Link Project</label>
        <input type="text" class="form-input" id="f_link_project" placeholder="https://...">
      </div>

      <div class="form-group">
        <label class="form-label">Link GitHub</label>
        <input type="text" class="form-input" id="f_github_url" placeholder="https://github.com/username/repo">
      </div>

      <div class="form-group">
        <label class="form-label">Teknologi</label>
        <input type="text" class="form-input" id="f_teknologi" placeholder="Flutter,Dart,Supabase">
        <p class="form-hint">Pisah dengan koma</p>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal()">Batal</button>
      <button class="btn btn-primary" id="saveBtn" onclick="saveProject()">Simpan</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
  // ── CONFIG ──────────────────────────────────────────────
  let API_BASE = localStorage.getItem('nochyos_api_base') || '';
  let AUTH_TOKEN = sessionStorage.getItem('nochyos_token') || '';
  let projects = [];
  let editingId = null;

  // ── INIT ────────────────────────────────────────────────
  window.onload = async function() {
    // Pastikan API_BASE menunjuk ke server admin (port 3000), bukan origin halaman
    if (!API_BASE || API_BASE.indexOf(':8080') !== -1) {
      API_BASE = 'http://localhost:3000';
      localStorage.setItem('nochyos_api_base', API_BASE);
    }
    document.getElementById('settingsApiUrl').value = API_BASE;
    if (AUTH_TOKEN) {
      // Verifikasi token lama masih valid
      try {
        const res = await fetch(`${API_BASE}/api/projects`, { headers: { 'x-admin-token': AUTH_TOKEN } });
        if (res.status === 401) {
          AUTH_TOKEN = '';
          sessionStorage.removeItem('nochyos_token');
        } else {
          showAdmin();
        }
      } catch (e) {
        showAdmin();
      }
    }
  };

  // ── LOGIN ───────────────────────────────────────────────
  async function login() {
    const pwd = document.getElementById('loginPassword').value;
    if (!pwd) return;

    // Default API ke server admin (port 3000), bukan origin halaman
    if (!API_BASE || API_BASE.indexOf(':8080') !== -1) {
      API_BASE = 'http://localhost:3000';
      localStorage.setItem('nochyos_api_base', API_BASE);
      document.getElementById('settingsApiUrl').value = API_BASE;
    }

    try {
      const res = await fetch(`${API_BASE}/api/projects`, {
        headers: { 'x-admin-token': pwd }
      });
      if (res.status === 401) {
        document.getElementById('loginError').style.display = 'block';
        document.getElementById('loginError').textContent = 'Password salah';
        return;
      }
      if (!res.ok) {
        document.getElementById('loginError').style.display = 'block';
        document.getElementById('loginError').textContent = 'API tidak ditemukan. Cek URL di Settings (default: http://localhost:3000)';
        return;
      }
      AUTH_TOKEN = pwd;
      sessionStorage.setItem('nochyos_token', AUTH_TOKEN);
      document.getElementById('loginError').style.display = 'none';
      showAdmin();
    } catch (e) {
      document.getElementById('loginError').style.display = 'block';
      document.getElementById('loginError').textContent = 'Tidak bisa konek ke API. Pastikan server admin (port 3000) jalan.';
    }
  }

  function logout() {
    AUTH_TOKEN = '';
    sessionStorage.removeItem('nochyos_token');
    document.getElementById('adminLayout').style.display = 'none';
    document.getElementById('loginScreen').style.display = 'flex';
  }

  function showAdmin() {
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('adminLayout').style.display = 'flex';
    loadProjects();
  }

  // ── SETTINGS ────────────────────────────────────────────
  function saveSettings() {
    API_BASE = document.getElementById('settingsApiUrl').value.trim();
    localStorage.setItem('nochyos_api_base', API_BASE);
    toast('Settings disimpan', 'success');
  }

  // ── NAVIGATION ──────────────────────────────────────────
  function showPage(name, el) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById('page-' + name).classList.add('active');
    if (el) el.classList.add('active');
  }

  // ── API HELPERS ─────────────────────────────────────────
  async function apiFetch(path, options = {}) {
    const url = `${API_BASE}/api${path}`;
    const res = await fetch(url, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        'x-admin-token': AUTH_TOKEN,
        ...(options.headers || {}),
      },
    });
    return res.json();
  }

  // ── LOAD PROJECTS ────────────────────────────────────────
  async function loadProjects() {
    document.getElementById('projectList').innerHTML = `
      <div class="loading"><div class="spinner"></div> Memuat data...</div>`;
    try {
      const data = await apiFetch('/projects');
      if (data.status === 'ok') {
        projects = data.data;
        renderProjects(projects);
      } else throw new Error(data.error);
    } catch (e) {
      document.getElementById('projectList').innerHTML = `
        <div class="empty-state">
          <div class="empty-icon">❌</div>
          <p>${e.message}</p>
          <p style="font-size:12px;color:#555;margin-bottom:16px">Pastikan API Base URL sudah diset di Settings</p>
          <button class="btn btn-secondary" onclick="loadProjects()">Coba Lagi</button>
        </div>`;
    }
  }

  // ── RENDER ──────────────────────────────────────────────
  function renderProjects(list) {
    if (!list.length) {
      document.getElementById('projectList').innerHTML = `
        <div class="empty-state">
          <div class="empty-icon">📂</div>
          <p>Belum ada project</p>
          <button class="btn btn-primary" onclick="openAddModal()">+ Tambah Project</button>
        </div>`;
      return;
    }

    document.getElementById('projectList').innerHTML = `
      <div class="project-grid">
        ${list.map(p => `
          <div class="project-card">
            ${p.url_thumbnail
              ? `<img class="project-thumb" src="${p.url_thumbnail}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
              : ''}
            <div class="project-thumb-placeholder" ${p.url_thumbnail ? 'style="display:none"' : ''}>📁</div>
            <div class="project-body">
              <div class="project-title">${p.judul}</div>
              <div class="project-desc">${p.deskripsi}</div>
              <div class="tech-tags">
                ${(Array.isArray(p.teknologi) ? p.teknologi : []).slice(0,4)
                  .map(t => `<span class="tech-tag">${t}</span>`).join('')}
              </div>
              <div class="project-actions">
                <button class="btn btn-secondary btn-sm" onclick="openEditModal('${p.id}')">✏️ Edit</button>
                <button class="btn btn-danger btn-sm" onclick="confirmDelete('${p.id}', '${p.judul.replace(/'/g,"\\'")}')">🗑️ Hapus</button>
              </div>
            </div>
          </div>
        `).join('')}
      </div>`;
  }

  // ── MODAL ───────────────────────────────────────────────
  function openAddModal() {
    editingId = null;
    document.getElementById('modalTitle').textContent = 'Tambah Project';
    clearForm();
    document.getElementById('projectModal').classList.add('open');
  }

  function openEditModal(id) {
    const p = projects.find(x => x.id === id);
    if (!p) return;
    editingId = id;
    document.getElementById('modalTitle').textContent = 'Edit Project';
    document.getElementById('editId').value = id;
    document.getElementById('f_judul').value = p.judul || '';
    document.getElementById('f_deskripsi').value = p.deskripsi || '';
    document.getElementById('f_url_thumbnail').value = p.url_thumbnail || '';
    document.getElementById('f_url_thumbnail_manual').value = p.url_thumbnail || '';
    document.getElementById('f_gambar_detail').value = Array.isArray(p.gambar_detail) ? p.gambar_detail.join(',') : '';
    document.getElementById('f_link_project').value = p.link_project || '';
    document.getElementById('f_github_url').value = p.github_url || '';
    document.getElementById('f_teknologi').value = Array.isArray(p.teknologi) ? p.teknologi.join(',') : '';

    // Show thumb preview
    if (p.url_thumbnail) {
      const prev = document.getElementById('thumbPreview');
      prev.src = p.url_thumbnail;
      prev.style.display = 'block';
    }

    document.getElementById('projectModal').classList.add('open');
  }

  function closeModal() {
    document.getElementById('projectModal').classList.remove('open');
  }

  function clearForm() {
    ['editId','f_judul','f_deskripsi','f_url_thumbnail','f_url_thumbnail_manual','f_gambar_detail','f_link_project','f_github_url','f_teknologi']
      .forEach(id => document.getElementById(id).value = '');
    const prev = document.getElementById('thumbPreview');
    prev.style.display = 'none';
    prev.src = '';
  }

  // ── UPLOAD ──────────────────────────────────────────────
  async function handleUpload(input, type) {
    const file = input.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);

    toast('Mengupload gambar...', 'success');

    try {
      const res = await fetch(`${API_BASE}/api/upload`, {
        method: 'POST',
        headers: { 'x-admin-token': AUTH_TOKEN },
        body: formData,
      });
      const data = await res.json();
      if (data.status === 'ok') {
        document.getElementById('f_url_thumbnail').value = data.url;
        document.getElementById('f_url_thumbnail_manual').value = data.url;
        const prev = document.getElementById('thumbPreview');
        prev.src = data.url;
        prev.style.display = 'block';
        toast('Upload berhasil!', 'success');
      } else throw new Error(data.error);
    } catch (e) {
      toast('Upload gagal: ' + e.message, 'error');
    }
  }

  async function handleMultiUpload(input) {
    const files = Array.from(input.files);
    if (!files.length) return;

    toast(`Mengupload ${files.length} gambar...`, 'success');
    const urls = [];

    for (const file of files) {
      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch(`${API_BASE}/api/upload`, {
          method: 'POST',
          headers: { 'x-admin-token': AUTH_TOKEN },
          body: formData,
        });
        const data = await res.json();
        if (data.status === 'ok') urls.push(data.url);
      } catch (e) {
        console.error(e);
      }
    }

    const existing = document.getElementById('f_gambar_detail').value.trim();
    const all = existing ? existing + ',' + urls.join(',') : urls.join(',');
    document.getElementById('f_gambar_detail').value = all;
    toast(`${urls.length} gambar berhasil diupload`, 'success');
  }

  // ── SAVE ────────────────────────────────────────────────
  async function saveProject() {
    const judul = document.getElementById('f_judul').value.trim();
    const deskripsi = document.getElementById('f_deskripsi').value.trim();
    if (!judul || !deskripsi) { toast('Judul, Deskripsi wajib diisi', 'error'); return; }

    const project = { judul, deskripsi,
      url_thumbnail: document.getElementById('f_url_thumbnail').value.trim(),
      gambar_detail: document.getElementById('f_gambar_detail').value.trim(),
      link_project:  document.getElementById('f_link_project').value.trim(),
      github_url:    document.getElementById('f_github_url').value.trim(),
      teknologi:     document.getElementById('f_teknologi').value.trim(),
    };

    const btn = document.getElementById('saveBtn');
    btn.textContent = 'Menyimpan...'; btn.disabled = true;

    try {
      let data;
      if (editingId) {
        data = await apiFetch(`/projects?id=${editingId}`, { method: 'PUT', body: JSON.stringify(project) });
      } else {
        data = await apiFetch('/projects', { method: 'POST', body: JSON.stringify(project) });
      }
      if (data.status === 'ok') {
        toast(editingId ? 'Project diupdate!' : 'Project ditambahkan!', 'success');
        // Sinkron ke OS NochyOS (folder Work) supaya muncul di desktop
        try {
          const fileId = editingId || String(judul).toLowerCase().replace(/[^a-z0-9]+/g, '-');
          const filePayload = {
            id: fileId,
            kind: 'project',
            title: judul,
            folder: 'Work',
            page: 1,
            desc: deskripsi,
            skills: Array.isArray(project.teknologi) ? project.teknologi : String(project.teknologi || '').split(',').map(s => s.trim()).filter(Boolean),
            link: project.link_project || '',
            image: project.url_thumbnail || '',
            app: '',
          };
          const existingFile = await apiFetch(`/files?id=${fileId}`);
          if (existingFile.status === 'ok') {
            await apiFetch(`/files?id=${fileId}`, { method: 'PUT', body: JSON.stringify(filePayload) });
          } else {
            await apiFetch('/files', { method: 'POST', body: JSON.stringify(filePayload) });
          }
        } catch (fe) { console.warn('Sync ke files gagal:', fe.message); }
        closeModal();
        loadProjects();
      } else throw new Error(data.error);
    } catch (e) {
      toast('Gagal: ' + e.message, 'error');
    } finally {
      btn.textContent = 'Simpan'; btn.disabled = false;
    }
  }

  // ── DELETE ──────────────────────────────────────────────
  function confirmDelete(id, judul) {
    if (!confirm(`Hapus "${judul}"?`)) return;
    apiFetch(`/projects?id=${id}`, { method: 'DELETE' })
      .then(data => {
        if (data.status === 'ok') { toast('Dihapus!', 'success'); loadProjects(); }
        else throw new Error(data.error);
      })
      .catch(e => toast('Gagal: ' + e.message, 'error'));
  }

  // ── TOAST ───────────────────────────────────────────────
  function toast(msg, type = 'success') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toastContainer').appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  document.getElementById('projectModal').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeModal();
  });
</script>
</body>
</html>
